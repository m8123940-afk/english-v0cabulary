# Скопируйте в .env и заполните. Файл .env не коммитьте в git.

# Токен бота от @BotFather
BOT_TOKEN=123456:replace-me

# Файл базы данных SQLite (создаётся автоматически)
DB_PATH=english_bot.sqlite3

# Распознавание речи: none (тогда ответы текстом) или openai (Whisper API, платно)
STT_PROVIDER=none
OPENAI_API_KEY=

# Telegram Mini App: публичный HTTPS-адрес, где запущен miniapp (например https://words.example.com)
MINIAPP_URL=
# Только для разработки в браузере без Telegram (?dev=<твой id>). В продакшене оставьте пустым.
MINIAPP_DEV_MODE=
